{
    "id": "kubernetes",
    "version": "1.0.2",
    "name": "kubernetes",
    "description": "Develop applications using kubectl",
    "documentationURL": "https://github.com/jhoareaumarion/devcontainers/blob/main/src/kubectl/README.md",
    "publisher": "jhoareaumarion",
    "licenseURL": "https://github.com/jhoareaumarion/devcontainers/blob/main/LICENSE",
    "options": {
        "imageVariant": {
            "type": "string",
            "description": "The tag version of the pre-built image to use",
            "proposals": ["1.0.1","1.0.2","latest"],
            "default": "latest"
        }
    },
    "platforms": ["Python"],
    "optionalPaths": [
        ".github/*"
    ]
}
